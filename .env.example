# Copy to .env and fill in. .env is git-ignored. Never commit real credentials.

# Your EGYM Wellpass login (needed only for class search/booking; studio search
# works without it). Requires an active Wellpass membership.
WELLPASS_EMAIL=
WELLPASS_PASSWORD=

# Optional. A stable device id for the API's user-agent. If unset, a random one
# is generated per run. Set it to keep a consistent device identity.
# WELLPASS_DEVICE_ID=

# Optional. Override the app version reported to the API (defaults shown).
# WELLPASS_APP_VERSION=6.6.1
# WELLPASS_APP_VERSION_CODE=353
